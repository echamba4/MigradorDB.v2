{
  "name": "nexoradb-desktop",
  "private": true,
  "version": "0.1.0",
  "main": "src/main.js",
  "type": "commonjs",
  "scripts": {
    "dev": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "dependencies": {
    "electron": "^30.0.0",
    "tree-kill": "^1.2.2"
  },
  "devDependencies": {
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "ec.nexora.nexoradb",
    "productName": "NexoraDB Studio",
    "files": [
      "src/**/*",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "../api/dist",
        "to": "api/dist"
      },
      {
        "from": "../api/package.json",
        "to": "api/package.json"
      },
      {
        "from": "../engine",
        "to": "engine"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64"]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
